#!/bin/bash
set -euo pipefail
if (( $# )); then
    echo 'Usage: poulygon (Q or Escape exits; switching consoles also exits)' >&2
    exit 2
fi
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
log="$root/poulygon.log"
# A spare VT lets fbterm release its display ownership before the game starts.
printf -v renderer '%q ' "$root/lib/ld-linux.so.2" --library-path "$root/lib" "$root/bin/facet"
printf -v quoted_log '%q' "$log"
# openvt replaces stderr, so redirect after it attaches the new console.
printf -v command '%q ' systemd-inhibit --what=idle --mode=block --who=Poulygon \
    '--why=Native GPU session' /bin/openvt -s -w -- /bin/bash -c "exec $renderer 2>>$quoted_log"
exec sudo /bin/bash -c "exec $command"
